# Copy to .env and fill in. Never commit the real .env file.

# Google Drive / Workspace (Stage 1)
GOOGLE_SERVICE_ACCOUNT_JSON=path/to/service-account.json
GOOGLE_WORKSPACE_DOMAIN=yourcompany.com

# Anthropic (Stages 2, 3, 4, 5)
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides - defaults are chosen for cost/quality per stage.
# EXTRACTION_MODEL=claude-haiku-4-5-20251001
# BLUEPRINT_MODEL=claude-sonnet-5
# TICKET_MODEL=claude-haiku-4-5-20251001
# CODEGEN_MODEL=claude-opus-4-8

# Notion (Stage 3 - blueprint + approval gate)
NOTION_API_TOKEN=ntn_...
NOTION_DATABASE_ID_BLUEPRINTS=...

# GitHub (Stages 4, 5 - tickets + code generation PRs)
GITHUB_TOKEN=ghp_...
GITHUB_REPO_OWNER=yourorg
GITHUB_REPO_NAME=yourrepo

# GCP (deploy, used by scripts/poll_transcripts_function.py)
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1

# Behavior tuning (all optional, defaults shown)
# POLLING_INTERVAL_SECONDS=120
# TRANSCRIPT_RETRY_LIMIT=6
# APPROVAL_TIMEOUT_HOURS=24
# DATA_DIR=data
